# Ambiente local: copie este arquivo para .env.local e mantenha-o fora do Git.
ESCRITORIO_NOME=Tiago Neves Advocacia Empresarial
SECRET_KEY=gere-uma-chave-local-longa-e-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PRIMARY_DOMAIN=

ADMIN_USERNAME=tiago
ADMIN_PASSWORD=defina-uma-senha-local-forte
ADMIN_EMAIL=tiagoneves.jus@gmail.com

POSTGRES_DB=juriai
POSTGRES_USER=juriai
POSTGRES_PASSWORD=defina-uma-senha-local-forte
POSTGRES_PORT=5432

# As chaves de IA sao opcionais no ambiente local.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Triagem jurídica: classifica eventos e sugere conferência; não cria prazos.
OPENAI_TRIAGEM_ENABLED=true
OPENAI_TRIAGEM_MODEL=gpt-4.1-mini
TRIAGEM_USERNAME=tiago
TRIAGEM_SCHEDULE_HOUR=7
TRIAGEM_SCHEDULE_MINUTE=50
PRAZOS_USERNAME=tiago
PRAZOS_SCHEDULE_HOUR=8
PRAZOS_SCHEDULE_MINUTE=0
IA_EMBEDDING_BACKEND=openai
IA_CLAUDE_MODEL=claude-opus-4-8
Q_SYNC=True

# DataJud: chave publica vigente divulgada na Wiki do CNJ. Nao a fixe no codigo.
DATAJUD_API_KEY=

# DJEN/Comunica PJe: identificacao profissional usada somente no monitoramento local.
DJEN_OAB_NUMERO=
DJEN_OAB_UF=
DJEN_USERNAME=tiago
DJEN_SCHEDULE_HOUR=7
DJEN_SCHEDULE_MINUTE=10
DJEN_RETRY_DELAY_MINUTES=15

# Backup local diário, salvo na pasta backups/ e retido pelo período definido.
BACKUP_SCHEDULE_HOUR=3
BACKUP_SCHEDULE_MINUTE=30
BACKUP_RETENTION_DAYS=30
# Dia do mês para teste isolado de restauração (1 = mensal).
BACKUP_RESTORE_VERIFY_DAY=1
BACKUP_REPORT_USERNAME=tiagoneves.jus@gmail.com
BACKUP_REPORT_SCHEDULE_HOUR=3
BACKUP_REPORT_SCHEDULE_MINUTE=45

# Google Workspace: somente leitura de Gmail e Google Agenda.
# O token renovavel e salvo localmente em data/google-oauth-token.json, que nao entra no Git.
GOOGLE_OAUTH_CLIENT_ID=
# Defina somente no .env.local a partir do JSON baixado no Console Google.
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_TOKEN_FILE=/app/data/google-oauth-token.json
GOOGLE_SYNC_ENABLED=false
GOOGLE_SYNC_USERNAME=tiago
GOOGLE_SYNC_SCHEDULE_HOUR=7
GOOGLE_SYNC_SCHEDULE_MINUTE=25
GOOGLE_SYNC_RETRY_DELAY_MINUTES=15
GOOGLE_GMAIL_QUERY=label:inbox newer_than:2d -category:promotions -category:social
GOOGLE_CALENDAR_DAYS_AHEAD=14
# Para envio por OAuth, reautorize a conta com gmail.send e informe o remetente opcional.
GOOGLE_EMAIL_FROM=

# Google Drive: catálogo permanente, somente leitura, da pasta Clientes.
# Se houver mais de uma pasta com esse nome, informe o ID da pasta correta.
GOOGLE_DRIVE_SYNC_ENABLED=false
GOOGLE_DRIVE_SYNC_USERNAME=tiago
GOOGLE_DRIVE_CLIENTES_FOLDER_ID=
GOOGLE_DRIVE_SYNC_SCHEDULE_HOUR=7
GOOGLE_DRIVE_SYNC_SCHEDULE_MINUTE=45
GOOGLE_DRIVE_SYNC_RETRY_DELAY_MINUTES=20
GOOGLE_DRIVE_MAX_DEPTH=3
GOOGLE_DRIVE_MAX_FILES=1000
# Pastas mais importantes para a rotina processual, separadas por vírgula.
GOOGLE_DRIVE_PRIORITY_FOLDER_NAMES=

# Notificações: mantenha a entrega externa desativada até configurar cada canal.
NOTIFICATIONS_DELIVERY_ENABLED=false
# Com a consolidação ativa, DJEN, Gmail, Agenda e DataJud aguardam a triagem
# e geram somente um alerta por processo.
NOTIFICATIONS_CONSOLIDATE_EVENTS=true
NOTIFICATIONS_EMAIL_ENABLED=false
NOTIFICATIONS_EMAIL_MODE=google_oauth
ALERT_EMAIL_TO=
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
NOTIFICATIONS_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATIONS_WHATSAPP_ENABLED=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
# Para alertas proativos, crie e aprove na Meta o template "juri_ai_alerta"
# com trÃªs variÃ¡veis no corpo: tÃ­tulo, mensagem e link.
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
NOTIFICATIONS_PUSH_ENABLED=false

# Atualização diária de movimentações dos processos públicos cadastrados.
DATAJUD_SYNC_USERNAME=tiago
DATAJUD_SYNC_SCHEDULE_HOUR=7
DATAJUD_SYNC_SCHEDULE_MINUTE=35
DATAJUD_SYNC_RETRY_DELAY_MINUTES=20
DATAJUD_SYNC_MAX_PROCESSOS=12
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:seu-email@exemplo.com
